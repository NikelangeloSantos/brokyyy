# Kopiere diese Datei zu ".env" und trage dort deine echten Werte ein.
# Die .env-Datei steht in .gitignore und landet NIE im Repo.
# In der Claude-Cloud-Umgebung nicht nötig: dort setzt der Netzwerk-Proxy den Schlüssel ein.

# ElevenLabs (Voiceover) – Schlüssel im ElevenLabs-Konto unter API Keys
ELEVENLABS_API_KEY=
# optional: überschreibt voice_id / model_id aus bausteine/stimme.toml
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
