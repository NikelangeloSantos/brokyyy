# Kopiere diese Datei zu ".env" und trage dort deine echten Werte ein.
# Die .env-Datei steht in .gitignore und landet NIE im Repo.

# ElevenLabs (Voiceover) – Schlüssel im ElevenLabs-Konto unter API Keys
ELEVENLABS_API_KEY=
# ID der Erzählerstimme (in ElevenLabs bei der Stimme zu finden)
ELEVENLABS_VOICE_ID=
